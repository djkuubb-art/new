{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/:market/post", "destination": "/" },
    { "source": "/:market/reel", "destination": "/" },
    { "source": "/:market/story", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, no-cache, max-age=0, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/anna-events.js",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, no-cache, max-age=0, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/:market/post",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, no-cache, max-age=0, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" },
        { "key": "X-Robots-Tag", "value": "noindex, follow, noarchive" }
      ]
    },
    {
      "source": "/:market/reel",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, no-cache, max-age=0, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" },
        { "key": "X-Robots-Tag", "value": "noindex, follow, noarchive" }
      ]
    },
    {
      "source": "/:market/story",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, no-cache, max-age=0, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" },
        { "key": "X-Robots-Tag", "value": "noindex, follow, noarchive" }
      ]
    },
    {
      "source": "/analytics",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, no-cache, max-age=0, must-revalidate" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; font-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" }
      ]
    },
    {
      "source": "/analytics.html",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, no-cache, max-age=0, must-revalidate" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; font-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
